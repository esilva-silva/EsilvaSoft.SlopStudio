<Project Sdk="Microsoft.NET.Sdk">
  <!-- Measurement tool for autocomplete; not part of the product and never published. -->
  <!-- Doubles as a test project: the AI evaluation harness in Ai/ lives here (phase 3, increment 3.6) and its own
       correctness tests must run in the regular suite, while the report generator stays [Explicit]. GenerateProgramFile
       is off because Program.cs already owns the entry point used by BenchmarkSwitcher. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/EsilvaSoft.SlopStudio.Autocomplete.Core/EsilvaSoft.SlopStudio.Autocomplete.Core.csproj" />
    <ProjectReference Include="../../src/EsilvaSoft.SlopStudio.LocalAi.Core/EsilvaSoft.SlopStudio.LocalAi.Core.csproj" />
    <ProjectReference Include="../../src/EsilvaSoft.SlopStudio.Application/EsilvaSoft.SlopStudio.Application.csproj" />
    <!-- L16: os benchmarks de commit de schema aprendido medem o repositorio LiteDB real, nao um fake. -->
    <ProjectReference Include="../../src/EsilvaSoft.SlopStudio.Infrastructure/EsilvaSoft.SlopStudio.Infrastructure.csproj" />
    <!-- A44: o AiRuntimeHarness mede modelos ONNX reais; sem esta referencia so haveria fake, e fake nao prova real. -->
    <ProjectReference Include="../../src/EsilvaSoft.SlopStudio.Infrastructure.LocalAi/EsilvaSoft.SlopStudio.Infrastructure.LocalAi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>
</Project>
