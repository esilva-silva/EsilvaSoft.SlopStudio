<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Proxy MCP por STDIO (lote 3 da fase 7). Referencia apenas Core/Application: não referencia Infrastructure,
    LiteDB, MongoDB.Driver nem providers. O pacote MCP fica confinado a este executável.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EsilvaSoft.SlopStudio.Core/EsilvaSoft.SlopStudio.Core.csproj" />
    <ProjectReference Include="../EsilvaSoft.SlopStudio.Application/EsilvaSoft.SlopStudio.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
    <!-- ModelContextProtocol.Core 2.2.0 exige >= 10.0.10; o pin central (10.0.0) é mantido nos demais projetos. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EsilvaSoft.SlopStudio.UnitTests" />
  </ItemGroup>
</Project>
