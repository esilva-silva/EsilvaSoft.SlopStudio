<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EsilvaSoft.SlopStudio.Desktop.ViewModels" xmlns:core="using:EsilvaSoft.SlopStudio.Core" x:Class="EsilvaSoft.SlopStudio.Desktop.EnvironmentsWindow" x:DataType="vm:EnvironmentsViewModel" Title="Ambientes / Key Vault" Width="760" Height="540" MinWidth="600" MinHeight="420" WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <StackPanel Spacing="4">
      <TextBlock Text="Ambientes / Key Vault" Classes="section-title"/>
      <TextBlock Text="Credenciais na URI são opcionais. Reutilize valores com ENV.get(&quot;chave&quot;)." Classes="muted" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="8">
        <TextBlock Text="Ambiente para editar e ativar"/>
        <ComboBox x:Name="EnvironmentSelector" ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" HorizontalAlignment="Stretch" AutomationProperties.Name="Ambiente para editar e ativar">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="core:EnvironmentDefinition"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Text="{Binding EnvironmentName}" PlaceholderText="Nome do novo ambiente" AutomationProperties.Name="Nome do novo ambiente"/>
          <Button Grid.Column="1" Content="Criar ambiente" Command="{Binding AddEnvironmentCommand}"/>
        </Grid>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel x:Name="KeysPanel" Spacing="6">
            <TextBlock Text="Chaves deste ambiente"/>
            <ListBox ItemsSource="{Binding Keys}" SelectedItem="{Binding SelectedKey}" Height="112" AutomationProperties.Name="Chaves deste ambiente"/>
            <Button Content="Remover chave selecionada" Command="{Binding RemoveValueCommand}"/>
          </StackPanel>
          <StackPanel x:Name="ValuePanel" Grid.Column="1" Spacing="6">
            <TextBox Text="{Binding Key}" PlaceholderText="Chave (ex.: MONGO_PASSWORD)" AutomationProperties.Name="Chave"/>
            <TextBox Text="{Binding Value}" PasswordChar="●" PlaceholderText="Valor" AutomationProperties.Name="Valor da variável"/>
            <Button Content="Adicionar / atualizar variável" Command="{Binding SetValueCommand}"/>
            <TextBlock Text="Sem chaves? Adicione a primeira variável. Cada ambiente mantém seus próprios valores." Classes="metadata" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="Armazenamento local no workspace, sem criptografia por cofre nativo. Valores não entram nos snapshots de rascunhos. Fechar descarta alterações não salvas." Classes="metadata" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Spacing="8">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Fechar" Click="CloseDialog"/>
        <Button Content="Salvar e ativar ambiente" Classes="primary" Command="{Binding SaveCommand}"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
