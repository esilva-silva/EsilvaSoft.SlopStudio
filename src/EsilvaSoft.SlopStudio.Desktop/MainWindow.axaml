<Window xmlns="https://github.com/avaloniaui" xmlns:syntax="using:EsilvaSoft.SlopStudio.Desktop.SyntaxHighlighting" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EsilvaSoft.SlopStudio.Desktop.ViewModels" xmlns:local="using:EsilvaSoft.SlopStudio.Desktop" x:Class="EsilvaSoft.SlopStudio.Desktop.MainWindow" x:DataType="vm:WorkspaceViewModel" Title="EsilvaSoft.SlopStudio" Icon="/Assets/slop-studio.ico" Width="1440" Height="900" MinWidth="960" MinHeight="620">
  <Grid RowDefinitions="40,*,36">
    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="8,3">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="4">
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.Name="Slop Studio">
          <Image Source="{StaticResource BrandSymbol}" Width="32" Height="32" />
          <TextBlock Text="slop studio" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="ConnectionsButton" Click="OpenConnections" ToolTip.Tip="Abrir ou gerenciar conexões" AutomationProperties.Name="Conexões">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="command-icon" Data="{StaticResource DatabaseIcon}" />
            <TextBlock Text="Conexões" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Command="{Binding NewTabCommand}" ToolTip.Tip="Novo script (Ctrl+T)" AutomationProperties.Name="Nova aba">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="command-icon" Data="{StaticResource PlusIcon}" />
            <TextBlock Text="Nova aba" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Click="OpenFile" ToolTip.Tip="Abrir arquivo (Ctrl+O)" AutomationProperties.Name="Abrir">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="command-icon" Data="{StaticResource OpenIcon}" />
            <TextBlock Text="Abrir" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="4" Click="SaveFile" IsEnabled="{Binding HasActiveTab}" ToolTip.Tip="Salvar aba (Ctrl+S)" AutomationProperties.Name="Salvar">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="command-icon" Data="{StaticResource SaveIcon}" />
            <TextBlock Text="Salvar" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="5" Click="OpenTools" IsEnabled="{Binding HasActiveTab}" ToolTip.Tip="Documentos, índices, administração e transferências" AutomationProperties.Name="Ferramentas">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="command-icon" Data="{StaticResource ToolsIcon}" />
            <TextBlock Text="Ferramentas" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="6" Content="Ambientes" Click="OpenEnvironments" HorizontalAlignment="Center" ToolTip.Tip="Ambientes / Key Vault"/>
        <ComboBox Grid.Column="7" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="100" AutomationProperties.Name="Tema" />
        <Button Grid.Column="8" Content="···" ToolTip.Tip="Mais ações" AutomationProperties.Name="Mais ações">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Salvar como…" Click="SaveAs" />
              <MenuItem Header="Preferências…" Click="OpenPreferences" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>
    <Grid x:Name="WorkspaceGrid" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" MinWidth="200" MaxWidth="420" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="500" />
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SecondaryBackground}">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="8" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Bancos" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Command="{Binding RefreshExplorerCommand}" ToolTip.Tip="Atualizar nó selecionado" AutomationProperties.Name="Atualizar bancos">
              <Path Classes="command-icon" Data="{StaticResource RefreshIcon}" />
            </Button>
          </Grid>
          <TextBox Grid.Row="1" Text="{Binding Search}" PlaceholderText="Buscar nos itens carregados" AutomationProperties.Name="Buscar bancos e coleções" />
          <Grid Grid.Row="2">
            <TreeView x:Name="Explorer" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode}" DoubleTapped="OpenExplorerCollection" KeyDown="ExplorerKeyDown">
              <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:ExplorerNodeViewModel">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="IsVisible" Value="{Binding IsVisible}" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:ExplorerNodeViewModel" ItemsSource="{Binding Children}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" ContextRequested="ExplorerContextRequested">
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Conectar" Click="ExplorerConnect" IsVisible="{Binding IsConnection}"/>
                        <MenuItem Header="Informações da instância" Click="ExplorerServerInfo" IsVisible="{Binding IsConnection}"/>
                        <MenuItem Header="Desconectar" Click="ExplorerDisconnect" IsVisible="{Binding IsConnection}"/>
                        <MenuItem Header="Atualizar" Click="ExplorerRefresh"/>
                        <MenuItem Header="Abrir documentos / consulta" Click="ExplorerOpenDocuments" IsVisible="{Binding IsCollection}"/>
                        <MenuItem Header="Ver índices" Click="ExplorerViewIndexes" IsVisible="{Binding HasCollection}"/>
                        <MenuItem Header="Detalhes e estatísticas" Click="ExplorerDetails"/>
                        <MenuItem Header="Abrir shell / script" Click="ExplorerGenerate" Tag="Shell"/>
                        <MenuItem Header="Script de criação de coleção" Click="ExplorerGenerate" Tag="CreateCollection" IsVisible="{Binding IsDatabase}"/>
                        <MenuItem Header="Script de remoção do banco" Click="ExplorerGenerate" Tag="DropDatabase" IsVisible="{Binding IsDatabase}"/>
                        <MenuItem Header="Criar coleção…" Click="ExplorerTools" Tag="Coleções" IsVisible="{Binding IsDatabase}"/>
                        <MenuItem Header="Documentos: inserir / atualizar / excluir…" Click="ExplorerTools" Tag="Documentos" IsVisible="{Binding IsCollection}"/>
                        <MenuItem Header="Criar / remover índices…" Click="ExplorerTools" Tag="Índices" IsVisible="{Binding HasCollection}"/>
                        <MenuItem Header="Gerar script CRUD" IsVisible="{Binding HasCollection}">
                          <MenuItem Header="Find" Click="ExplorerGenerate" Tag="Find"/>
                          <MenuItem Header="Insert" Click="ExplorerGenerate" Tag="Insert"/>
                          <MenuItem Header="Update" Click="ExplorerGenerate" Tag="Update"/>
                          <MenuItem Header="Delete" Click="ExplorerGenerate" Tag="Delete"/>
                          <MenuItem Header="Create Index" Click="ExplorerGenerate" Tag="CreateIndex"/>
                          <MenuItem Header="Drop Collection" Click="ExplorerGenerate" Tag="DropCollection"/>
                          <MenuItem Header="Statistics" Click="ExplorerGenerate" Tag="Statistics"/>
                        </MenuItem>
                        <MenuItem Header="Script de criação do índice" Click="ExplorerGenerate" Tag="CreateIndex" IsVisible="{Binding IsIndex}"/>
                        <MenuItem Header="Remover índice…" Click="ExplorerDropIndex" IsVisible="{Binding IsIndex}"/>
                        <MenuItem Header="Copiar definição" Click="ExplorerCopyDefinition" IsVisible="{Binding IsIndex}"/>
                        <MenuItem Header="Administração do banco / coleção…" Click="ExplorerTools" Tag="Coleções"/>
                      </ContextMenu>
                    </Grid.ContextMenu>
                    <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.75" Data="{StaticResource DatabaseIcon}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" ToolTip.Tip="{Binding Message}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
            <StackPanel IsVisible="{Binding HasNoConnections}" Margin="12,32" Spacing="12">
              <TextBlock Text="Seus bancos aparecem aqui" FontWeight="Medium" TextWrapping="Wrap" />
              <TextBlock Text="Abra uma conexão para carregar os bancos. As coleções serão carregadas ao expandir." Classes="muted" TextWrapping="Wrap" />
              <Button Content="Abrir conexão" Click="OpenConnections" />
            </StackPanel>
          </Grid>
          <Expander Grid.Row="3" Header="Detalhes do item" IsExpanded="True" MaxHeight="240">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Details.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="Carregando…" IsVisible="{Binding Details.IsLoading}" Classes="metadata"/>
              <Button Content="Instâncias / topologia…" IsVisible="{Binding Details.IsConnection}" Click="SelectExplorerInstance"/>
              <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Text="{Binding Details.Text}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="120" ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="12" AutomationProperties.Name="Detalhes do explorer"/>
            </StackPanel>
          </Expander>
          <TextBlock Grid.Row="4" Text="{Binding ExplorerStatus}" Classes="metadata" TextWrapping="Wrap" MaxHeight="40" />
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DragCompleted="ExplorerResized" />
      <Grid Grid.Column="2">
        <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab}" Background="{DynamicResource PanelBackground}" IsVisible="{Binding HasActiveTab}">
          <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WorkspaceTabViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Title}" MaxWidth="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Context}" />
                <Button Content="×" Classes="quiet" Padding="4,0" MinHeight="28" Click="CloseTab" AutomationProperties.Name="Fechar aba" />
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:WorkspaceTabViewModel">
              <local:WorkspaceTabView />
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>
        <StackPanel IsVisible="{Binding !HasActiveTab}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <Image Source="{StaticResource BrandSymbol}" Width="80" Height="80" HorizontalAlignment="Left" />
          <TextBlock Text="Slop Studio" FontSize="24" FontWeight="Bold" />
          <TextBlock Text="Seu espaço de trabalho" Classes="section-title" />
          <TextBlock Text="Abra uma coleção ou crie um script para começar." Classes="muted" />
          <Button Command="{Binding NewTabCommand}" AutomationProperties.Name="Nova aba">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="command-icon" Data="{StaticResource PlusIcon}" />
              <TextBlock Text="Nova aba" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource SecondaryBackground}" Padding="8,3">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
        <TextBlock Text="{Binding Operations.State}" Classes="metadata" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding Operations.IsRunning}" VerticalAlignment="Center">
          <ProgressBar MinWidth="0" Width="100" Height="6" IsIndeterminate="{Binding Operations.IsIndeterminate}" Value="{Binding Operations.Progress}" Minimum="0" Maximum="100" AutomationProperties.Name="Progresso da operação" />
          <TextBlock Text="{Binding Operations.ProgressLabel}" Classes="metadata" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Operations.Description}" Classes="metadata" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Operations.Description}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding Operations.Additional}" Classes="metadata" VerticalAlignment="Center" />
        <Button Grid.Column="4" Content="Cancelar" Command="{Binding Operations.CancelCommand}" IsVisible="{Binding Operations.CanCancel}" MinHeight="28" Height="28" Padding="8,0" AutomationProperties.Name="Cancelar operação em destaque" />
        <TextBlock Grid.Column="5" Text="{Binding SessionStatus}" MaxWidth="230" Classes="metadata" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SessionStatus}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
